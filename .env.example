# AgentDrill configuration — copy to .env and fill in real values.
# AgentDrill never persists or logs these; they are read at runtime only.

# LLM-as-judge providers (optional; only needed when using --judge)
AGENTDRILL_OPENAI_API_KEY=
AGENTDRILL_ANTHROPIC_API_KEY=

# Defaults (override agentdrill.toml)
AGENTDRILL_JUDGE_MODEL=openai:gpt-4o-mini
AGENTDRILL_OUTPUT_DIR=.agentdrill
AGENTDRILL_LOG_LEVEL=info

# Security
AGENTDRILL_SANDBOX=false
