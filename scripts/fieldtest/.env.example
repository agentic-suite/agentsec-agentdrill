# Field-test environment. Copy to `.env` and edit.
# Results are written to field-test/<FT_VERSION>/results/<run-id>/ (see the plan).

# --- version / results root ---------------------------------------------------
FT_VERSION=v0.1.0

# --- local LLM: oMLX on the host (OpenAI-compatible) --------------------------
# oMLX listens on the host at port 8000. The harness probes it host-side at
# FT_LLM_HOST_URL and the SUT container reaches it via FT_LLM_BASE_URL
# (host.docker.internal). No LLM container is used. Variables are namespaced
# FT_LLM_* so the ambient environment (e.g. a coding agent's OPENAI_*/LLM_*
# vars) can never leak into a field-test LLM call.
FT_LLM_HOST_URL=http://127.0.0.1:8000
FT_LLM_BASE_URL=http://host.docker.internal:8000/v1
FT_LLM_MODEL=Qwen3-4B-Instruct-2507-4bit
FT_JUDGE_MODEL=Qwen3.5-4B-4bit
FT_LLM_API_KEY=

# --- image pins ---------------------------------------------------------------
FT_TAG=local
# The sandbox image used by run_in_container / tests/test_security_docker_llm.py
AGENTDRILL_DOCKER_IMAGE=agentdrill-agent-runner

# --- stack behavior -----------------------------------------------------------
STACK_TIMEOUT=180
STACK_KEEP=0
FT_SANDBOX=false

# --- deep verification --------------------------------------------------------
# FT_STRICT_GROUNDING=1 (default): a PASS with no grounded assertion fails.
# FT_STRICT_STEPS=1: gen_cases.py fails while any weak (surface) step remains.
FT_STRICT_GROUNDING=1
FT_STRICT_STEPS=0