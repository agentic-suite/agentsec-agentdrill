{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentic-suite/agentdrill/schema/pack.schema.json",
  "title": "agentdrill attack pack",
  "type": "object",
  "required": ["pack", "cases"],
  "additionalProperties": false,
  "properties": {
    "pack": {
      "type": "object",
      "required": ["name", "version", "description", "min_agentdrill", "license", "trust"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "description": { "type": "string" },
        "min_agentdrill": { "type": "string" },
        "license": { "type": "string" },
        "trust": { "enum": ["built-in", "local", "external"] }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "goal", "incident_ref", "target", "driver", "attack", "oracle", "tags"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
          "title": { "type": "string" },
          "goal": { "type": "string" },
          "incident_ref": { "type": "string" },
          "target": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["agentgate", "agentkeys", "agentseatbelt", "agentkernel", "policyweave-output", "agenthalt"] },
              "config": { "type": "object" }
            }
          },
          "driver": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["subprocess", "python", "http", "claude-code", "cursor"] },
              "config": { "type": "object" }
            }
          },
          "attack": {
            "type": "object",
            "required": ["steps"],
            "properties": {
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["tool"],
                  "properties": {
                    "tool": { "type": "string" },
                    "args": { "type": "object" }
                  }
                }
              }
            }
          },
          "benign_twin": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
          "oracle": {
            "type": "object",
            "required": ["expect"],
            "properties": {
              "expect": { "enum": ["blocked", "missed", "degraded"] },
              "dimensions": {
                "type": "array",
                "items": { "enum": ["compatibility", "enforcement", "integrity"] }
              },
              "expect_telemetry": {
                "type": "array",
                "items": { "enum": ["denied", "policy-fired", "secret-detected", "revoked", "halted"] }
              },
              "kill_time": {
                "type": "object",
                "properties": { "max_seconds": { "type": "integer", "minimum": 0 } }
              }
            }
          },
          "cleanup": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["cmd"],
              "properties": {
                "cmd": { "type": "string" },
                "expect": { "enum": ["success"] }
              }
            }
          },
          "tags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "difficulty": { "enum": ["easy", "medium", "hard"] },
          "budget": {
            "type": "object",
            "properties": {
              "max_steps": { "type": "integer", "minimum": 0 },
              "max_cost_usd": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
